    "pinyin-pro": "3.29.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
