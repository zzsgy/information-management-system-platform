<?xml version="1.0" encoding="UTF-8"?>
<!-- 档案模块的独立启动器；平台接入时复用 identity/archive/workflow 业务边界。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
  <groupId>com.company.ims</groupId><artifactId>archive-service</artifactId><version>0.1.0</version>
  <name>信息管理系统档案模块</name>
  <properties>
    <!-- 字节码目标固定为 Java 21，Windows/Linux 使用同一构建产物。 -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 可指定隔离构建目录，避免Windows旧产物被占用时覆盖既有版本。 -->
    <ims.build.directory>${project.basedir}/target</ims.build.directory>
    <!-- 两个应用入口显式选择；默认构建继续保留旧档案系统。 -->
    <ims.main.class>com.company.ims.ArchiveApplication</ims.main.class>
    <ims.web.directory>../web/dist</ims.web.directory>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <!-- 正式邮件使用维护中的SMTP实现，超时与TLS由平台消息适配器显式配置。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
    <!-- 读取SMTP明确拒绝码，区分可重试失败与发送结果未知；版本由Boot统一管理。 -->
    <dependency><groupId>org.eclipse.angus</groupId><artifactId>angus-mail</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-csv</artifactId><version>1.14.1</version></dependency>
    <!-- 使用真实SQL/事务及显式测试替身，不引入需要动态附加JVM的Mockito。 -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope><exclusions>
      <exclusion><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId></exclusion>
      <exclusion><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId></exclusion>
    </exclusions></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope><exclusions>
      <exclusion><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId></exclusion>
      <exclusion><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId></exclusion>
    </exclusions></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${ims.build.directory}</directory>
    <!-- 前端先由 scripts/java/build 构建，再打入同一个 JAR；运行服务器不需要 Node。 -->
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${ims.web.directory}</directory><targetPath>static</targetPath></resource>
    </resources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>${ims.main.class}</mainClass></configuration></plugin></plugins>
  </build>
  <profiles>
    <!-- 新平台使用独立产物目录及网页，防止覆盖旧系统可执行包。 -->
    <profile><id>platform</id><properties>
      <ims.main.class>com.company.platform.PlatformApplication</ims.main.class>
      <ims.web.directory>../web/dist-platform</ims.web.directory>
      <ims.build.directory>${project.basedir}/target-platform</ims.build.directory>
    </properties></profile>
  </profiles>
</project>
